<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.UsersController" spacing="15">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Zarządzanie Użytkownikami i Pracownikami" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Szukaj po e-mailu lub nazwie..." prefWidth="250" onKeyReleased="#handleSearch"/>
        <Button text="Usuń Wybranego" onAction="#handleDeleteUser" style="-fx-background-color: #d9534f; -fx-text-fill: white;"/>
        <Label fx:id="statusLabel" text="Ładowanie..." style="-fx-text-fill: gray;"/>
    </HBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameCol" text="Nazwa / Imię" prefWidth="150"/>
            <TableColumn fx:id="emailCol" text="Adres E-mail" prefWidth="250"/>
            <TableColumn fx:id="roleCol" text="Rola systemowa" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>