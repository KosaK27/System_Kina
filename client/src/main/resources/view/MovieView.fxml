<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MovieController"
      spacing="8">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Szukaj po tytule lub opisie..."
                   prefWidth="280" onAction="#search"/>
        <Button text="Szukaj" onAction="#search"/>
        <Button text="Wyczyść" onAction="#clearFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="adminControls" spacing="6">
            <Button text="Dodaj" onAction="#addMovie"/>
            <Button text="Edytuj" onAction="#editMovie"/>
            <Button text="Usuń" onAction="#deleteMovie"/>
        </HBox>
    </HBox>

    <FlowPane fx:id="genreCheckboxes" hgap="10" vgap="4"/>

    <TableView fx:id="movieTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID" prefWidth="50" sortable="true"/>
            <TableColumn fx:id="titleColumn"
                         text="Tytuł" prefWidth="220" sortable="true"/>
            <TableColumn fx:id="descriptionColumn"
                         text="Opis" prefWidth="300" sortable="true"/>
            <TableColumn fx:id="durationColumn"
                         text="Czas (min)" prefWidth="100" sortable="true"/>
            <TableColumn fx:id="genreColumn"
                         text="Gatunek" prefWidth="110" sortable="true"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel"/>
</VBox>